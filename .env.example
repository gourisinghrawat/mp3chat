# MongoDB Configuration
MONGODB_URI=your_mongodb_atlas_connection_string

# Server Configuration
PORT=8181
NODE_ENV=development

# Application URL (update for production)
# Local: https://localhost:8181
# Vercel: https://your-app.vercel.app
APP_URL=https://localhost:8181

# Email Configuration (Gmail SMTP)
# To enable email notifications, set ENABLE_EMAILS=true
ENABLE_EMAILS=false

# Gmail account to send emails from
EMAIL_USER=your-email@gmail.com

# Gmail App Password (16 characters, no spaces)
EMAIL_APP_PASSWORD=your-16-character-app-password

# Socket.IO Configuration
MEETING_PASSWORD=optional_meeting_password

# Vercel Configuration (automatically set by Vercel)
# VERCEL_URL=your-app.vercel.app
