# ==================================
# Environment Configuration Template
# ==================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# ==================================
# Node Environment
# ==================================
# Options: development | production
NODE_ENV=development

# ==================================
# MongoDB Configuration
# ==================================
# Your MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://your-username:your-password@cluster0.xxxxx.mongodb.net/video-call-db

# ==================================
# Server Configuration
# ==================================
# Port for the application (Render uses this)
PORT=8181

# Your application URL
# Development: https://localhost:8181
# Production: https://your-app-name.onrender.com
APP_URL=https://localhost:8181

# Frontend URL for CORS
# Development: https://localhost:8181
# Production: https://your-app-name.onrender.com
FRONTEND_URL=https://localhost:8181

# ==================================
# Email Configuration (Optional)
# ==================================
# Enable/disable email notifications
# Set to 'true' to enable, 'false' to disable
ENABLE_EMAILS=false

# Gmail account to send emails from
# Example: noreply@gmail.com
EMAIL_USER=your-email@gmail.com

# Gmail App Password (16 characters)
# Generate at: https://myaccount.google.com/apppasswords
# Example: abcd efgh ijkl mnop
EMAIL_APP_PASSWORD=your-16-character-app-password

# ==================================
# Render Deployment Values (Production)
# ==================================
# Use these values when deploying to Render:
# 
# NODE_ENV=production
# PORT=8181
# MONGODB_URI=mongodb+srv://...
# FRONTEND_URL=https://your-app-name.onrender.com
# APP_URL=https://your-app-name.onrender.com
# ENABLE_EMAILS=true
# EMAIL_USER=your-email@gmail.com
# EMAIL_APP_PASSWORD=your-app-password
# ==================================
